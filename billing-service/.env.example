# SaatDin billing service environment configuration
# Load these values in your shell or deployment platform before starting Spring.

APP_ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=sandbox

# JDBC URL. This can point to the same PostgreSQL database as FastAPI; Flyway
# owns only the separate "billing" schema.
BILLING_DB_URL=jdbc:postgresql://localhost:5432/postgres
BILLING_DB_USERNAME=postgres
BILLING_DB_PASSWORD=replace-me

# Must exactly match backend BILLING_SERVICE_API_KEY. Use 32+ random characters.
BILLING_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
BILLING_PROVIDER=sandbox
BILLING_SANDBOX_WEBHOOK_SECRET=replace-with-a-random-sandbox-secret
BILLING_COVERAGE_MAX_BATCH_SIZE=100
