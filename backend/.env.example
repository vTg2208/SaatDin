# SaatDin backend environment configuration
# Copy this file to backend/.env and replace the values required for your environment.

# Runtime mode: development or production.
APP_ENVIRONMENT=development

# Required PostgreSQL datasource (Supabase is the intended host).
# Example: postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Authentication and security
# Generate a secret with:
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace-me-in-env
JWT_EXPIRATION_MINUTES=1440

# Development-only OTP delivery. Production startup rejects this combination.
EXPOSE_DEBUG_OTP=true
SMS_PROVIDER=stub

# External trigger data. Open-Meteo needs no key for rain and heat.
WAQI_API_KEY=
TOMTOM_API_KEY=
NEWS_API_KEY=
TRIGGER_POLL_MINUTES=15

# Never turn static risk estimates into live payout triggers in production.
ALLOW_STATIC_TRIGGER_FALLBACK=false

# Fraud scoring
FRAUD_SCORING_ENABLED=true
# FRAUD_MODEL_PATH=backend/models/fraud/fraud_iforest_latest.joblib
FRAUD_ANOMALY_THRESHOLD=-0.05
FRAUD_FAIL_OPEN=true
FRAUD_LLM_FALLBACK_ENABLED=true
FRAUD_LLM_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Adversarial defenses
CLAIM_VELOCITY_SPIKE_THRESHOLD=15
CLAIM_VELOCITY_SPIKE_WINDOW_MINUTES=10
NEW_ACCOUNT_HOLD_DAYS=7
CO_CLAIM_GRAPH_ENABLED=true
CO_CLAIM_GRAPH_SCHEDULE_HOURS=24

# Premium billing
# Spring Boot is the authoritative payment ledger and coverage source. This key
# must exactly match billing-service BILLING_INTERNAL_API_KEY.
BILLING_SERVICE_ENABLED=true
BILLING_SERVICE_URL=http://127.0.0.1:8082
BILLING_SERVICE_API_KEY=replace-with-at-least-32-random-characters
BILLING_REQUEST_TIMEOUT_SECONDS=2
# Keep false in production unless the URL is a trusted private-network address.
BILLING_ALLOW_PRIVATE_HTTP=false

# The legacy FastAPI premium-write endpoint is only an emergency development
# fallback. Keep it disabled while the billing service is enabled.
ALLOW_CLIENT_REPORTED_PREMIUM_PAYMENTS=false

# Payouts
# This repository only implements a local payout sandbox. Production startup
# rejects any other payout mode until a live adapter is implemented.
PAYOUT_PROVIDER_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin dashboard
# Production requires a non-default username and a PBKDF2 password hash. Generate
# the hash from the repository root with:
# python -c "from backend.app.core.security import hash_password; print(hash_password('replace-this-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=saatdin-local

# JSON array of browser origins. Replace both values in production.
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
